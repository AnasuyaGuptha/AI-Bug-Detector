# Port for the backend server (default: 5000)
PORT=5000

# Optional: GitHub personal access token. Raises the GitHub API rate limit
# from 60 to 5,000 requests/hour. Needs no scopes - public data only.
# Create one at https://github.com/settings/tokens (fine-grained, "Public repositories" access).
GITHUB_TOKEN=

# Optional: comma-separated list of allowed frontend origins.
# If empty, any http://localhost:<port> origin is allowed.
CORS_ORIGIN=

# Required for AI bug analysis (POST /api/analyze). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: Gemma 4 model. Only gemma-4-26b-a4b-it (default, faster) or gemma-4-31b-it (larger) are accepted.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional: Gemini input-token limit per minute for your tier (free tier: 16000).
# The engine paces its requests to stay under it.
GEMINI_INPUT_TOKENS_PER_MINUTE=16000

# Optional: max AI requests per scan (default 4, about 2-3 minutes on the free tier).
# Each request covers about 9,000 tokens of the most relevant code. Raise it on a paid tier.
GEMMA_MAX_BATCHES=4
